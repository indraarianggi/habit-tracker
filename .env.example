# Required for dev/build: a monitored public inbox, shown on /privacy.
VITE_PRIVACY_CONTACT_EMAIL=

# Required for a live Google login. Use a separate OAuth web client per origin.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Writable SQLite location on persistent storage; parent directory is created automatically.
DATABASE_PATH=.data/habit-tracker.sqlite
