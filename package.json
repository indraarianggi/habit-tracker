{
  "name": "habit-tracker",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.20.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local ./node_modules/vite/bin/vite.js dev",
    "build": "node --env-file-if-exists=.env.local ./node_modules/vite/bin/vite.js build",
    "start": "node --env-file-if-exists=.env.local .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "smoke:browser": "playwright test"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@tanstack/react-router": "1.170.38",
    "@tanstack/react-start": "1.168.57",
    "better-auth": "1.6.23",
    "better-sqlite3": "12.6.0",
    "lucide-react": "1.47.0",
    "nitro": "3.0.260903-beta",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "auth": "1.6.23",
    "typescript": "6.0.2",
    "vite": "8.3.0"
  }
}
