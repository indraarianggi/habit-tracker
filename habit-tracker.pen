                  "fill": "$text-primary",
                  "content": "4. Account Deletion Rights",
                  "fontFamily": "$font-sans",
                  "fontSize": 14,
                  "fontWeight": "750"
                },
                {
                  "type": "text",
                  "id": "HPVu9",
                  "name": "SecBody",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "You may permanently delete your account and all associated tasks and check-ins at any time from Settings. Deletion is instantaneous on the server; backup snapshots expire naturally within 30 days.",
