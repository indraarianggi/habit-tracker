                  "content": "When you sign in with Google, we store your Google name, email, and profile avatar URL to identify your account. We store the Tasks you plan, Check-in records (task, day, and duration), Pomodoro sessions, and timer preferences.",
                  "lineHeight": 1.4,
                  "fontFamily": "$font-sans",
                  "fontSize": 12,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "F1osJ",
              "name": "SecCard-2. Privacy by Design & Zero Trackers",
              "width": "fill_container",
              "fill": "$surface",
              "cornerRadius": 20,
              "stroke": "$border",
              "strokeWidth": 1,
              "layout": "vertical",
              "gap": 6,
              "padding": 16,
              "children": [
                {
                  "type": "text",
                  "id": "c5Yd4X",
                  "name": "SecTitle",
                  "fill": "$text-primary",
                  "content": "2. Privacy by Design & Zero Trackers",
                  "fontFamily": "$font-sans",
                  "fontSize": 14,
                  "fontWeight": "750"
                },
                {
                  "type": "text",
                  "id": "wRrWh",
                  "name": "SecBody",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Your Tasks and Check-in history are strictly private to your account. We run no third-party analytics, tracking pixels, or advertising SDKs. Data is saved to your device first and replicated securely to our homelab server.",
                  "lineHeight": 1.4,
                  "fontFamily": "$font-sans",
                  "fontSize": 12,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "B0lxy",
              "name": "SecCard-3. Backups & 30-Day Retention",
              "width": "fill_container",
              "fill": "$surface",
              "cornerRadius": 20,
              "stroke": "$border",
              "strokeWidth": 1,
              "layout": "vertical",
              "gap": 6,
              "padding": 16,
              "children": [
                {
                  "type": "text",
                  "id": "Niht8",
                  "name": "SecTitle",
                  "fill": "$text-primary",
                  "content": "3. Backups & 30-Day Retention",
                  "fontFamily": "$font-sans",
                  "fontSize": 14,
                  "fontWeight": "750"
                },
                {
                  "type": "text",
                  "id": "Rd9Vr",
                  "name": "SecBody",
                  "fill": "$text-secondary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Encrypted database backups are maintained off-site for catastrophe recovery with a rolling 30-day retention schedule.",
                  "lineHeight": 1.4,
                  "fontFamily": "$font-sans",
                  "fontSize": 12,
                  "fontWeight": "normal"
                }
              ]
            },
            {
              "type": "frame",
              "id": "Y0zSPw",
              "name": "SecCard-4. Account Deletion Rights",
              "width": "fill_container",
              "fill": "$surface",
              "cornerRadius": 20,
              "stroke": "$border",
              "strokeWidth": 1,
              "layout": "vertical",
              "gap": 6,
              "padding": 16,
